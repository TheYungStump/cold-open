<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<FinalDraft DocumentType="Script" Template="No" Version="1">

  <Content>
    <Paragraph Type="Scene Heading">
      <Text>INT. LIGHTHOUSE - NIGHT</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>The lamp turns. Rain against the glass.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>MARA</Text>
    </Paragraph>
    <Paragraph Type="Parenthetical">
      <Text>(to herself)</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>Three ships tonight.</Text>
    </Paragraph>
    <Paragraph Type="Scene Heading">
      <Text>EXT. CLIFF PATH - DAWN</Text>
    </Paragraph>
    <Paragraph Type="Action">
      <Text>Gulls wheel over the rocks.</Text>
    </Paragraph>
    <Paragraph Type="Character">
      <Text>TOMAS</Text>
    </Paragraph>
    <Paragraph Type="Dialogue">
      <Text>She kept the light on.</Text>
    </Paragraph>
  </Content>

  <TitlePage>
    <Content>
      <Paragraph Alignment="Left" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="0">
        <Text></Text>
      </Paragraph>
      <Paragraph Alignment="Center" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="204">
        <Text>THE KEEPER'S LOG</Text>
      </Paragraph>
      <Paragraph Alignment="Center" LeftIndent="1.50" RightIndent="7.50" SpaceBefore="12">
        <Text>Cold Open tests</Text>
      </Paragraph>
    </Content>
  </TitlePage>

