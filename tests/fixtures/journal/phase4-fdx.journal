{"journal":"coldopen","v":1,"app":"0.1.0","doc":{"title_page":{"fields":[]},"blocks":[{"id":"b_1","type":"scene_heading","text":"INT. LIGHTHOUSE - NIGHT"},{"id":"b_2","type":"action","text":"The lamp turns. Rain against the glass."},{"id":"b_3","type":"character","text":"MARA"},{"id":"b_4","type":"parenthetical","text":"(to herself)"},{"id":"b_5","type":"dialogue","text":"Three ships tonight."},{"id":"b_6","type":"scene_heading","text":"EXT. CLIFF PATH - DAWN"},{"id":"b_7","type":"action","text":"Gulls wheel over the rocks."},{"id":"b_8","type":"character","text":"TOMAS"},{"id":"b_9","type":"dialogue","text":"She kept the light on."}],"next_id":10,"title_lines":[{"text":{"text":""},"align":"left","left":108,"right":540,"space_before":0},{"text":{"text":"THE KEEPER'S LOG"},"align":"center","left":108,"right":540,"space_before":204},{"text":{"text":"Cold Open tests"},"align":"center","left":108,"right":540,"space_before":12}],"fdx":{"style":{"newline":"\n","unit":"  "},"prolog":"<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"no\" ?>\n","root_open":"<FinalDraft DocumentType=\"Script\" Template=\"No\" Version=\"1\">","sections":["content",{"title_page":{"head":"\n\n  <TitlePage>\n    ","content":"<Content>\n      <Paragraph Alignment=\"Left\" LeftIndent=\"1.50\" RightIndent=\"7.50\" SpaceBefore=\"0\">\n        <Text></Text>\n      </Paragraph>\n      <Paragraph Alignment=\"Center\" LeftIndent=\"1.50\" RightIndent=\"7.50\" SpaceBefore=\"204\">\n        <Text>THE KEEPER'S LOG</Text>\n      </Paragraph>\n      <Paragraph Alignment=\"Center\" LeftIndent=\"1.50\" RightIndent=\"7.50\" SpaceBefore=\"12\">\n        <Text>Cold Open tests</Text>\n      </Paragraph>\n    </Content>","tail":"\n  </TitlePage>"}},{"text":"\n\n  <ElementSettings Type=\"Scene Heading\">\n    <FontSpec Font=\"Courier Prime\" Size=\"12\" Style=\"AllCaps\"/>\n    <ParagraphSpec Alignment=\"Left\" FirstIndent=\"0.00\" Leading=\"Regular\" LeftIndent=\"1.50\" RightIndent=\"7.50\" SpaceBefore=\"12\" Sp