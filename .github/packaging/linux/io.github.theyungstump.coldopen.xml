<?xml version="1.0" encoding="UTF-8"?>
<!-- The three file types Cold Open opens (docs/specs/release.md §5). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="text/x-fountain">
    <comment>Fountain screenplay</comment>
    <sub-class-of type="text/plain"/>
    <glob pattern="*.fountain"/>
  </mime-type>
  <mime-type type="application/x-fdx">
    <comment>Screenplay (.fdx)</comment>
    <sub-class-of type="application/xml"/>
    <glob pattern="*.fdx"/>
  </mime-type>
  <mime-type type="application/x-coldopen">
    <comment>Cold Open project</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.coldopen"/>
  </mime-type>
</mime-info>
